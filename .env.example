# Salin menjadi .env bila ingin mengubah konfigurasi default.
# Semua nilai di bawah opsional untuk demo lokal.

# Kunci sesi Flask — WAJIB diganti untuk deployment nyata.
SECRET_KEY=dev-only-secret-change-me

# SQLite (default) atau PostgreSQL, contoh:
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/procurement
# DATABASE_URL=sqlite:///instance/procurement.db

# Lokasi hasil build frontend (default: frontend/dist)
# SPA_DIST=frontend/dist

# Port untuk `python main.py` (tidak dipakai `flask run`)
PORT=5000
